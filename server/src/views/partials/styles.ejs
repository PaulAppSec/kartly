<style>
  :root {
    --ink:#1A1712; --paper:#FAF8F4; --surface:#fff; --brand:#FF5A3C; --accent:#0E7C7B;
    --muted:#8A8175; --line:#ECE6DC; --ok:#1F9D55; --warn:#E0A400;
    --shadow:0 6px 24px rgba(26,23,18,.06);
  }
  * { box-sizing:border-box; }
  body {
    margin:0; background:var(--paper); color:var(--ink);
    font-family:"Plus Jakarta Sans",ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
    line-height:1.55;
  }
  h1,h2,h3 { font-family:"Space Grotesk",ui-sans-serif,system-ui,sans-serif; letter-spacing:-.02em; margin:0 0 .3em; }
  a { color:var(--accent); text-decoration:none; }
  .wrap { max-width:820px; margin:0 auto; padding:40px 24px; }
  .brand { display:inline-flex; align-items:center; gap:10px; font-family:"Space Grotesk",sans-serif; font-weight:700; font-size:1.3rem; }
  .brand .g { width:28px; height:28px; display:grid; place-items:center; background:var(--brand); color:#fff; border-radius:8px; transform:rotate(-6deg); font-weight:700; }
  .card { background:var(--surface); border:1px solid var(--line); border-radius:16px; box-shadow:var(--shadow); padding:28px; }
  .muted { color:var(--muted); }
  .tag { display:inline-block; background:#FFE8E2; color:var(--brand); font-weight:700; font-size:.72rem; padding:3px 10px; border-radius:999px; }
  .row { display:flex; justify-content:space-between; align-items:center; gap:16px; }
  table { width:100%; border-collapse:collapse; }
  th,td { text-align:left; padding:12px 10px; border-bottom:1px solid var(--line); font-size:.92rem; }
  th { color:var(--muted); font-size:.74rem; text-transform:uppercase; letter-spacing:.06em; }
  .tnum { font-variant-numeric:tabular-nums; }
  .total { font-family:"Space Grotesk",sans-serif; font-weight:700; font-size:1.4rem; }
  .btn { display:inline-block; background:var(--brand); color:#fff; font-weight:700; padding:10px 18px; border-radius:999px; }

  /* Admin "operator" look — denser, cooler surface */
  body.admin { background:#12100C; color:#EDE7DC; }
  .admin .shell { display:grid; grid-template-columns:230px 1fr; min-height:100vh; }
  .admin .side { background:#1A1712; border-right:1px solid #2A241C; padding:24px 16px; }
  .admin .side a { display:block; color:#B8AE9E; padding:10px 12px; border-radius:10px; font-weight:600; font-size:.92rem; margin-bottom:2px; }
  .admin .side a.on, .admin .side a:hover { background:#241E16; color:#fff; }
  .admin .main { padding:32px 36px; }
  .admin h1 { color:#fff; }
  .admin .card { background:#1A1712; border-color:#2A241C; color:#EDE7DC; box-shadow:none; }
  .admin table th { color:#8A8175; }
  .admin table td { border-color:#2A241C; }
  .admin .kpis { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:28px; }
  .admin .kpi { background:#1A1712; border:1px solid #2A241C; border-radius:14px; padding:20px; }
  .admin .kpi b { display:block; font-family:"Space Grotesk",sans-serif; font-size:2rem; color:#fff; }
  .admin .kpi span { color:#8A8175; font-size:.82rem; }
  .admin .badge { font-size:.7rem; color:#FF7A5C; letter-spacing:.1em; text-transform:uppercase; font-weight:700; }
</style>
