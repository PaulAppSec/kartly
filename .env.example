# ─────────────────────────────────────────────────────────────
# Kartly environment — LOCAL ONLY. Never deploy with these values.
# Copy to `.env` (docker-compose reads it). Do not commit `.env`.
# ─────────────────────────────────────────────────────────────

# Node
NODE_ENV=development

# App server — bound to localhost only in docker-compose (127.0.0.1)
PORT=4000
# Public origin of the client, used for CORS + redirect base.
CLIENT_ORIGIN=http://localhost:4000

# Postgres (the `db` service in docker-compose)
POSTGRES_USER=kartly
POSTGRES_PASSWORD=kartly_dev_password
POSTGRES_DB=kartly
# Connection string the app uses. Host `db` = the compose service name.
DATABASE_URL=postgresql://kartly:kartly_dev_password@db:5432/kartly?schema=public

# JWT — placeholder; real secret handling arrives with the auth feature (Phase 2)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_RESET_SECRET=dev-reset-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_RESET_TTL=30m

# Uploads
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_BYTES=5242880

# Local email outbox — rendered emails are written here; nothing is actually sent.
OUTBOX_DIR=/app/outbox
